# === Production Environment Variables ===
# Copy this file to .env and fill in real values before deploying.
#
# Usage:
#   cp .env.production .env
#   nano .env
#   docker compose -f docker-compose.prod.yml up -d --build

# Database
DB_PASSWORD=change-me-to-a-strong-password

# JWT Secret (must be at least 32 characters)
JWT_SECRET=change-me-to-a-256-bit-secret-key-at-least-32-bytes

# OpenAI (required for AI blog generation)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Tavily (optional — for web research in AI pipeline)
TAVILY_API_KEY=tvly-your-tavily-api-key-here
